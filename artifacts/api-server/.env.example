# API Server Environment Variables Template
# Copy this file to .env and fill in your actual values

# ──────────────────────────────────────────────────────────────────────
# EMAIL SERVICE CONFIGURATION
# Choose ONE method:
# ──────────────────────────────────────────────────────────────────────

# Option 1: Resend (Recommended for serverless/Vercel)
# Sign up at https://resend.com
RESEND_API_KEY=re_

# Option 2: SendGrid
# Sign up at https://sendgrid.com
SENDGRID_API_KEY=SG.

# Option 3: SMTP (Gmail, Office365, etc.)
# For Gmail, generate App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email sender address
SENDER_EMAIL=noreply@daralnaseem.com

# ──────────────────────────────────────────────────────────────────────
# GOOGLE SHEETS CONFIGURATION
# Choose ONE method:
# ──────────────────────────────────────────────────────────────────────

# Option 1: Google Apps Script (Easiest)
# Create a Google Apps Script that accepts POST requests
# See QUIZ_SETUP_GUIDE.md for detailed instructions
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxcjdKK1HNe6Slsz1Xm-v-vuf_pUALLv4EtQRnGlfuW7CyQWlcYCyAKa39zA1zb7Q8/exec

# Option 2: Webhook Service (Zapier/Make)
# Create automation at zapier.com or make.com
SHEETS_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxx/

# Option 3: Direct Google Sheets API (Advanced)
# Sheet ID from URL: docs.google.com/spreadsheets/d/{SHEET_ID}/
GOOGLE_SHEETS_ID=

# Service account JSON key (base64 encoded)
# Generate at https://console.cloud.google.com/
GOOGLE_SERVICE_ACCOUNT_JSON=

# ──────────────────────────────────────────────────────────────────────
# NOTIFICATION EMAIL
# ──────────────────────────────────────────────────────────────────────
# Where quiz submissions should be sent
NOTIFICATION_EMAIL=rasoolkhan990880@gmail.com

# ──────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ──────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (if needed for future enhancements)
# ──────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/luxury_estate
